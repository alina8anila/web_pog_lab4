    {
      "name": "02. Games — життєвий цикл",
      "description": "Створює тимчасову гру, оновлює та видаляє її. Seed-дані не змінюються.",
      "item": [
        {
          "name": "Create game",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/games",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "games"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Test Game {{$timestamp}}\",\n  \"description\": \"Створено з Postman\",\n  \"rental_price_per_day\": 99.5,\n  \"play_time_mins\": 45,\n  \"min_players\": 2,\n  \"max_players\": 4,\n  \"complexity\": \"Easy\",\n  \"rating\": 4.2,\n  \"hub_id\": {{seed_hub_id}},\n  \"genre_ids\": [\n    {{seed_genre_id}}\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"created payload\", () => {",
                  "  pm.expect(body).to.have.all.keys(\"id\", \"title\", \"status\");",
                  "  pm.expect(body.id).to.be.a(\"number\");",
                  "  pm.expect(body.status).to.eql(\"created\");",
                  "});",
                  "",
                  "pm.collectionVariables.set(\"created_game_id\", body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update game",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/games/{{created_game_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "games",
                "{{created_game_id}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Test Game Updated {{$timestamp}}\",\n  \"description\": \"Створено з Postman\",\n  \"rental_price_per_day\": 109.5,\n  \"play_time_mins\": 45,\n  \"min_players\": 2,\n  \"max_players\": 4,\n  \"complexity\": \"Easy\",\n  \"rating\": 4.2,\n  \"hub_id\": {{seed_hub_id}},\n  \"genre_ids\": [\n    {{seed_genre_id}}\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
