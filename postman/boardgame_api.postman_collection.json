            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "",
                  "pm.test(\"CORS header\", () => {",
                  "  pm.expect(pm.response.headers.get(\"Access-Control-Allow-Origin\"))",
                  "    .to.eql(\"http://localhost:5500\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "CORS preflight",
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "http://localhost:5500"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "GET"
              }
            ],
            "url": {
              "raw": "{{base_url}}/games",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "games"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "",
                  "pm.test(\"CORS preflight headers\", () => {",
                  "  pm.expect(pm.response.headers.get(\"Access-Control-Allow-Origin\"))",
                  "    .to.eql(\"http://localhost:5500\");",
                  "  pm.expect(pm.response.headers.get(\"Access-Control-Allow-Methods\"))",
                  "    .to.include(\"GET\");",
                  "});"
                ]
              }
            }
          ]
        }
