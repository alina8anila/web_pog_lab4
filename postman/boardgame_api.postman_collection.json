                  "const ratings = pm.response.json().results.map((game) => game.rating);",
                  "",
                  "pm.test(\"rating descending\", () => {",
                  "  pm.expect(ratings).to.eql([...ratings].sort((a, b) => b - a));",
                  "});"
                ]
              }
            }
          ]
        },
