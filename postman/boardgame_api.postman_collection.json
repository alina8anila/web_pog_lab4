{
  "info": {
    "name": "BoardGame Hub API",
    "description": "Колекція для REST API BoardGame Hub (Django + DRF).\n\nПеред запуском: python3 manage.py migrate && python3 manage.py runserver.\nSeed-дані створюються міграцією 0003_add_data: 2 хаби, 3 жанри, 5 ігор.\nЗапускати через Collection Runner у порядку папок.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api/v1",
      "type": "string"
    },
    {
      "key": "seed_hub_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "seed_genre_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "seed_game_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "created_game_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "created_genre_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "created_hub_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Games — читання",
      "description": "",
      "item": [
        {
          "name": "List games",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/games",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "games"
              ]
            },
            "description": "Перелік ігор із пагінаційним форматом {count, results}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"count + results\", () => {",
                  "  pm.expect(body).to.have.all.keys(\"count\", \"results\");",
                  "  pm.expect(body.count).to.be.at.least(5);",
                  "  pm.expect(body.results).to.be.an(\"array\").that.is.not.empty;",
                  "});",
                  "",
                  "pm.test(\"decimals are numbers\", () => {",
                  "  const game = body.results[0];",
                  "  pm.expect(game.rating).to.be.a(\"number\");",
                  "  pm.expect(game.rental_price_per_day).to.be.a(\"number\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List games — filters",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/games?search=Catan&hub_id={{seed_hub_id}}&genre_id={{seed_genre_id}}&min_players=3&complexity=Medium&sort=price_asc",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "games"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "Catan"
                },
                {
                  "key": "hub_id",
                  "value": "{{seed_hub_id}}"
                },
                {
                  "key": "genre_id",
                  "value": "{{seed_genre_id}}"
                },
                {
                  "key": "min_players",
                  "value": "3"
                },
                {
                  "key": "complexity",
                  "value": "Medium"
                },
                {
                  "key": "sort",
                  "value": "price_asc"
                }
              ]
            },
            "description": "Перевірка search + hub_id + min_players + complexity + sort."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"filtered results\", () => {",
                  "  pm.expect(body.results).to.be.an(\"array\").that.is.not.empty;",
                  "  body.results.forEach((game) => {",
                  "    pm.expect(game.title.toLowerCase()).to.include(\"catan\");",
                  "    pm.expect(game.min_players).to.be.at.most(3);",
                  "    pm.expect(game.max_players).to.be.at.least(3);",
                  "    pm.expect(game.complexity).to.eql(\"Medium\");",
                  "    pm.expect(game.hub.id).to.eql(Number(pm.collectionVariables.get(\"seed_hub_id\")));",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List games — sort price_asc",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/games?sort=price_asc",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "games"
              ],
              "query": [
                {
                  "key": "sort",
                  "value": "price_asc"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "",
                  "const prices = pm.response.json().results.map((game) => game.rental_price_per_day);",
                  "",
                  "pm.test(\"price ascending\", () => {",
                  "  pm.expect(prices).to.eql([...prices].sort((a, b) => a - b));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List games — sort popularity",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/games?sort=popularity",
